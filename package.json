{
  "name": "paper-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm test && vite build && node scripts/package-server.mjs",
    "test:php": "php server/tests/contract-test.php",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "catalog:generate": "node scripts/build-catalog.mjs",
    "samples": "node scripts/create-samples.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  }
}
